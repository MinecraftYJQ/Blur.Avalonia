<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Blur.Avalonia;assembly=Blur.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Blur.Avalonia.Demo.MainWindow"
        Title="Blur.Avalonia.Demo">
    <Grid>
        <Grid RowDefinitions="*,*">
            <Border Grid.Row="0"
                    Background="Red"></Border>
            <Border Grid.Row="1"
                    Background="Blue"></Border>
        </Grid>
        
        <Grid Width="300"
              Height="300"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="Orange">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Style.Animations>
                        <Animation Duration="0:0:3"
                                   IterationCount="INFINITE">
                            <KeyFrame Cue="0%">
                                <Setter Property="Width"
                                        Value="500"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="50%">
                                <Setter Property="Width"
                                        Value="300"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Width"
                                        Value="500"></Setter>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Grid.Styles>
        </Grid>
        
        <avalonia:BlurSurface BlurRadius="100"
                              Margin="200"/>
    </Grid>
</Window>
